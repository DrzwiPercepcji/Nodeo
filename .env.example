# ===========================================
# Nodeo Configuration
# Copy to .env and fill in your values
# ===========================================
#
# Compose files:
#   docker-compose.yml          — backend + frontend only (no DB); pulls GHCR images (default
#                                 ghcr.io/drzwipercepcji/nodeo-{backend,frontend}:latest). Override with
#                                 NODEO_BACKEND_IMAGE / NODEO_FRONTEND_IMAGE if needed.
#   docker-compose.local.yml    — adds Postgres, Redis (optional cache), build: ./backend, ./frontend; use:
#                                 -f docker-compose.yml -f docker-compose.local.yml up -d --build
#                                 and POSTGRES_HOST=postgres (default below). Set REDIS_URL=redis://redis:6379 to enable stream cache.
#   docker-compose.e2e.yml      — adds MinIO for S3; use with local overlay for E2E (see docs/docker.md).
#
# Optional (forks / mirrors):
# NODEO_BACKEND_IMAGE=ghcr.io/your-org/your-repo-backend:latest
# NODEO_FRONTEND_IMAGE=ghcr.io/your-org/your-repo-frontend:latest
#

# --- Database (PostgreSQL) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=nodeo
POSTGRES_USER=nodeo
POSTGRES_PASSWORD=changeme

# --- Authentication (single user) ---
# Generate hash (from backend/): node -e "console.log(require('bcryptjs').hashSync('yourpassword', 12))"
#
# IMPORTANT (Docker Compose): bcrypt strings contain $. In .env you must escape each $ as $$ or the
# hash is corrupted and login fails. Example: if hash is $2b$12$abc... write:
#   AUTH_PASSWORD_HASH=$$2b$$12$$abc...
AUTH_USERNAME=admin
AUTH_PASSWORD_HASH=$$2b$$12$$your_bcrypt_hash_here

# --- JWT ---
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=generate-a-random-secret-here

# --- AWS S3 ---
S3_BUCKET=my-nodeo-bucket
S3_REGION=eu-central-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
# S3_ENDPOINT=                  # Optional: for S3-compatible storage (MinIO, etc.)

# --- CORS ---
# CORS_ORIGIN=*                 # Restrict to your domain in production, e.g. https://nodeo.example.com

# --- Ports ---
BACKEND_PORT=3000
FRONTEND_PORT=8080
# POSTGRES_EXPOSE_PORT=5432     # Uncomment to expose Postgres externally
# REDIS_EXPOSE_PORT=6379        # With docker-compose.local.yml (Redis for stream cache)

# --- Backend temp files (uploads / transcode scratch) ---
# Docker Compose sets NODEO_TEMP_DIR=/data/nodeo-tmp and mounts volume `nodeo_backend_tmp` (see docker-compose.yml).
# Locally without Docker, defaults to OS temp dir + /nodeo-uploads.

# --- Optional: Redis stream cache (plaintext byte ranges after decrypt) ---
# Omit REDIS_URL entirely to disable caching. With docker-compose.local.yml, Redis is available as:
# REDIS_URL=redis://redis:6379
# Logical DB: either add path to URL (redis://redis:6379/1) or set REDIS_DB (overrides path in REDIS_URL when set):
# REDIS_DB=0
# STREAM_CACHE_TTL_SECONDS=1800
# STREAM_CACHE_MAX_RANGE_BYTES=8388608
