# ===========================================
# Nodeo Configuration
# Copy to .env and fill in your values
# ===========================================
#
# Compose files:
#   docker-compose.yml          — backend + frontend only (no DB). Use when Postgres is elsewhere;
#                                 set POSTGRES_HOST to that host (not `postgres`).
#   docker-compose.local.yml    — adds Postgres; use with: -f docker-compose.yml -f docker-compose.local.yml
#                                 and POSTGRES_HOST=postgres (default below).
#   docker-compose.e2e.yml      — adds MinIO for S3; use with local overlay for E2E (see docs/docker.md).
#

# --- Database (PostgreSQL) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=nodeo
POSTGRES_USER=nodeo
POSTGRES_PASSWORD=changeme

# --- Authentication (single user) ---
# Generate hash (from backend/): node -e "console.log(require('bcryptjs').hashSync('yourpassword', 12))"
#
# IMPORTANT (Docker Compose): bcrypt strings contain $. In .env you must escape each $ as $$ or the
# hash is corrupted and login fails. Example: if hash is $2b$12$abc... write:
#   AUTH_PASSWORD_HASH=$$2b$$12$$abc...
AUTH_USERNAME=admin
AUTH_PASSWORD_HASH=$$2b$$12$$your_bcrypt_hash_here

# --- JWT ---
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=generate-a-random-secret-here

# --- AWS S3 ---
S3_BUCKET=my-nodeo-bucket
S3_REGION=eu-central-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
# S3_ENDPOINT=                  # Optional: for S3-compatible storage (MinIO, etc.)

# --- CORS ---
# CORS_ORIGIN=*                 # Restrict to your domain in production, e.g. https://nodeo.example.com

# --- Ports ---
BACKEND_PORT=3000
FRONTEND_PORT=8080
# POSTGRES_EXPOSE_PORT=5432     # Uncomment to expose Postgres externally
