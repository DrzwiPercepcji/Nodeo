# ===========================================
# Nodeo Configuration
# Copy to .env and fill in your values
# ===========================================

# --- Database (PostgreSQL) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=nodeo
POSTGRES_USER=nodeo
POSTGRES_PASSWORD=changeme

# --- Authentication (single user) ---
# Generate hash (from backend/): node -e "console.log(require('bcryptjs').hashSync('yourpassword', 12))"
#
# IMPORTANT (Docker Compose): bcrypt strings contain $. In .env you must escape each $ as $$ or the
# hash is corrupted and login fails. Example: if hash is $2b$12$abc... write:
#   AUTH_PASSWORD_HASH=$$2b$$12$$abc...
AUTH_USERNAME=admin
AUTH_PASSWORD_HASH=$$2b$$12$$your_bcrypt_hash_here

# --- JWT ---
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=generate-a-random-secret-here

# --- AWS S3 ---
S3_BUCKET=my-nodeo-bucket
S3_REGION=eu-central-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
# S3_ENDPOINT=                  # Optional: for S3-compatible storage (MinIO, etc.)

# --- Ports ---
BACKEND_PORT=3000
FRONTEND_PORT=8080
# POSTGRES_EXPOSE_PORT=5432     # Uncomment to expose Postgres externally
